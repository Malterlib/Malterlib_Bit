Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Bit}"
{
	%Group "Bit"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Bit/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Bit: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Bit"
	{
		!!MalterlibLibrary_Bit true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Bit: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Bit true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Bit"
	MalterlibTestFiles_Malterlib_Bit: [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}

