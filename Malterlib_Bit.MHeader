Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Bit}"
{
	%Group Bit
	{
		%Group Include
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Bit/^*"
		}
		%File "Source/*"
		%Group Documentation
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Bit true
	{
		&
		{
			MalterlibLibrary_Bit ""
			MalterlibLibrary_All true
		}
	}
	MalterlibSubLibraries "Bit;@(MalterlibSubLibraries)"
	{
		!!MalterlibLibrary_Bit true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Bit true
	MalterlibIncludeRoots "@('Include'->MakeAbsolute());@(MalterlibIncludeRoots)"
	{
		!!MalterlibLibrary_Bit true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests "Malterlib_Bit;@(MalterlibTests)"
	MalterlibTestFiles_Malterlib_Bit "@('Test/*'->MakeAbsolute())"
}

